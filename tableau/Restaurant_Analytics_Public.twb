      <column caption='HOUR AM/PM' datatype='string' name='[Calculation_1807181545791488]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [explicit_hour] = 0 THEN &apos;12 AM&apos;&#10;ELSEIF [explicit_hour] &lt; 12 THEN STR([explicit_hour]) + &apos; AM&apos;&#10;ELSEIF [explicit_hour] = 12 THEN &apos;12 PM&apos;&#10;ELSE STR([explicit_hour] - 12) + &apos; PM&apos;&#10;END' />
